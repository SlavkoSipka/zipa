{
  "name": "my-razzle-app",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "start": "npm-run-all -p watch-css start-razzle",
    "start-unix": "npm-run-all -p watch-css-unix start-razzle",
    "start-razzle": "razzle start",
    "build": "npm run build-css && razzle build",
    "test": "razzle test --env=jsdom",
    "start:prod": "NODE_ENV=production node build/server.js",
    "build-css": "sass src/App.scss src/App.css --no-source-map",
    "watch-css": "npm run build-css && sass --watch src/App.scss:src/App.css --no-source-map",
    "watch-css-unix": "npm run build-css && sass --watch src/App.scss:src/App.css --no-source-map"
  },
  "dependencies": {
    "@tinymce/tinymce-react": "^3.6.0",
    "bootstrap": "^4.4.1",
    "chart.js": "^2.9.3",
    "date-fns": "^2.15.0",
    "express": "^4.17.1",
    "moment": "^2.24.0",
    "node-fetch": "^2.6.0",
    "npm-run-all": "^4.1.5",
    "razzle": "^3.0.0",
    "react": "^16.12.0",
    "react-autosuggest": "^10.0.2",
    "react-barcode": "^1.4.0",
    "react-chartjs-2": "^2.9.0",
    "react-date-range": "^1.0.3",
    "react-document-meta": "^3.0.0-beta.2",
    "react-dom": "^16.12.0",
    "react-dropzone": "^6.2.2",
    "react-facebook-login": "^4.1.1",
    "react-github-login": "^1.0.3",
    "react-google-login": "^5.1.2",
    "react-grid-layout": "^0.16.6",
    "react-inlinesvg": "^1.2.0",
    "react-modal": "^3.16.1",
    "react-paginate": "^6.3.2",
    "react-redux": "^7.1.3",
    "react-router-dom": "^5.1.2",
    "react-share": "^4.2.1",
    "react-slick": "^0.26.1",
    "react-swipeable": "^7.0.1",
    "react-tagsinput": "^3.19.0",
    "reactstrap": "^8.4.1",
    "redux": "^4.0.5",
    "redux-form": "^8.3.0",
    "sass": "^1.69.0"
  }
}