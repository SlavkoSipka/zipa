# Kopiraj u .env i popuni pravim vrednostima. .env se NE commituje na git.

# --- Supabase Postgres ---
# Supabase -> Project Settings -> Database -> Connection string (Session pooler)
DATABASE_URL=postgresql://postgres.<ref>:<LOZINKA>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Cloudflare R2 (skladište fotografija) ---
# Cloudflare -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zipa-photos

# --- Tokeni za prijavu ---
# Nasumični dugački stringovi. Menjanje JWT_SECRET izbacuje sve korisnike iz sesije.
JWT_SECRET=
ADMIN_JWT_SECRET=

# --- Slanje mejlova ---
SMTP_HOST=mail.zipaphoto.net
SMTP_PORT=25
SMTP_USER=noreply@zipaphoto.net
SMTP_PASSWORD=

# --- Ostalo ---
# PORT postaviti SAMO lokalno. Na hostingu (Render i sl.) port zadaje sam
# hosting — ako se ovde upiše, server sluša na pogrešnom portu i sajt
# vraća 404 ("no-server").
PORT=10015

# Javni URL ovog API-ja (koristi se u mejlovima i u linkovima ka uploadima).
# Na hostingu: adresa servisa, npr. https://zipa.onrender.com
API_ENDPOINT=http://localhost:10015

# Adresa sajta — koristi se u linkovima koje saljemo mejlom
# (verifikacija naloga, promena lozinke, upit za cenu).
# Na hostingu: https://zipaphoto.net
SITE_URL=http://localhost:10016
